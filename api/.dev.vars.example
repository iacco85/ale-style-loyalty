AUTH_SECRET=changeme-local-dev-secret
ADMIN_PASSWORD=changeme-admin-password

# Solo sviluppo: con "true" la ruota si può girare senza il limite di una volta a settimana.
# Non impostarla mai in produzione (non va in wrangler.jsonc né nei secret).
SPIN_COOLDOWN_DISABLED=true

# Da https://console.firebase.google.com → Impostazioni progetto → Account di servizio
# → "Genera nuova chiave privata" (scarica un file .json con questi 3 campi).
# FCM_PRIVATE_KEY: incolla il valore "private_key" del json su una riga sola,
# lasciando i "\n" letterali così come sono nel file (il codice li converte lui).
FCM_PROJECT_ID=changeme-firebase-project-id
FCM_CLIENT_EMAIL=changeme@changeme.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nchangeme\n-----END PRIVATE KEY-----\n"
